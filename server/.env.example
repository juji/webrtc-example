# Postgres connection string. Matches docker-compose.yml's postgres service
# (user/password/db all "webrtc") when running the stack locally via
# `bun run dev`.
DATABASE_URL=postgres://webrtc:webrtc@localhost:5432/webrtc

# Signs the httpOnly session-cookie JWT issued at login/register (see
# server/src/session.ts). Any random string works locally; generate a real
# one with `openssl rand -hex 32`. Changing this invalidates every existing
# session (all users get logged out).
JWT_SECRET=

# Origins allowed to send credentialed (cookie-bearing) requests — must be
# an explicit list, not "*", since browsers reject credentialed CORS with a
# wildcard origin. Comma-separated. Mirrors RUSTFS_CORS_ALLOWED_ORIGINS below.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://webrtc-client.jujitest.com

# --- TURN credentials ---
# GET /turn/credentials tries each provider below in order (see
# server/src/routes/turn.ts) and uses the first one whose required vars are
# all set. Only one provider needs to be configured — coturn (self-hosted,
# via docker-compose.yml) is the default for local dev; the rest are
# alternatives for using a third-party TURN service instead.

# coturn (self-hosted) — COTURN_SECRET must match the root .env's
# COTURN_SECRET exactly, since the server signs credentials with it and the
# coturn container verifies them with the same value.
COTURN_SERVICE=localhost:3478
COTURN_SECRET=

# Cloudflare's public speed-test TURN endpoint — no account needed, but
# unofficial/undocumented and not meant for production use. Its response
# carries no credential expiry, so CF_SPEED_RENEW_SECONDS controls how often
# the client re-fetches (default 3600s / 1 hour if unset).
#CF_SPEED_SERVICE=1
#CF_SPEED_RENEW_SECONDS=3600

# Metered.ca
#METERED_SERVICE=
#METERED_API_KEY=

# Twilio
#TWILIO_SERVICE=
#TWILIO_AUTH_TOKEN=

# Xirsys
#XIRSYS_SERVICE=
#XIRSYS_SECRET=
#XIRSYS_CHANNEL=

# ExpressTURN
#EXPRESSTURN_SERVICE=free.expressturn.com:3478
#EXPRESSTURN_USERNAME=
#EXPRESSTURN_PASSWORD=

# --- Attachment storage (S3-compatible) ---
# Matches docker-compose.yml's rustfs service for local dev. Point these at
# a real S3-compatible endpoint (bucket, credentials) in production.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=webrtc
RUSTFS_SECRET_KEY=webrtcsecret

# --- Web Push ---
# Generate with: bunx web-push generate-vapid-keys
# Public key is served to the client via GET /push/vapid-public-key — not
# duplicated into a client-side env var.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

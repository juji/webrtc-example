# Read by docker-compose.yml to configure the local coturn (TURN) container.
# Must match server/.env's COTURN_SECRET exactly — the server signs
# short-lived TURN credentials with this same secret, and coturn verifies
# them with --static-auth-secret. Any random string works locally; generate
# one with `openssl rand -hex 32`.
COTURN_SECRET=

# Your machine's LAN IP (e.g. 192.168.1.x), passed to coturn's --external-ip
# so it advertises a relay address browsers can actually reach. Required
# because Docker Desktop can't use network_mode: host reliably on macOS/Windows —
# coturn runs in a container needing explicit port mapping instead, and without
# --external-ip it would advertise its unreachable internal container IP.
# Find yours with `ipconfig getifaddr en0` (macOS) or `hostname -I` (Linux).
COTURN_EXTERNAL_IP=

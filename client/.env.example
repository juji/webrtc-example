# Hono API + WebRTC signaling server (see server/.env).
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# RTCPeerConnection's iceTransportPolicy. "all" (default if unset) tries
# direct P2P first and falls back to TURN relay; "relay" forces every
# connection through TURN even when direct P2P would work — useful for
# reliably exercising the relay path during local dev/testing.
NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all

# Mounts the floating dev panel (SQLite explorer, etc.) — see
# client/components/dev-panel.tsx. Leave unset/false in production.
NEXT_PUBLIC_DEV=true

# --- Attachment extension filtering (optional) ---
# Client-side pre-upload check only, mirrors the server's
# ATTACHMENT_WHITELIST_EXTENSIONS / ATTACHMENT_BLACKLIST_EXTENSIONS (see
# server/.env.example) — the server-side check is the one actually
# enforced, this just avoids a round-trip for an obviously-blocked file.
# Comma-separated, case-insensitive, no leading dots. Whitelist overrides
# blacklist when set; unset falls back to the server's default blacklist.
#NEXT_PUBLIC_ATTACHMENT_WHITELIST_EXTENSIONS=
#NEXT_PUBLIC_ATTACHMENT_BLACKLIST_EXTENSIONS=
